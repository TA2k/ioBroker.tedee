{
  "i18n": true,
  "type": "tabs",
  "items": {
    "tab_connection": {
      "type": "panel",
      "label": "Connection",
      "items": {
        "_hdrBridge": {
          "type": "header",
          "text": "Tedee Bridge",
          "size": 3,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_description": {
          "type": "staticText",
          "text": "In the Tedee app select the bridge, open Settings → API and switch the API on. Enter the IP address and the token shown there. (If the API menu is missing, enable Beta testing in your user profile first.)",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_image": {
          "type": "staticImage",
          "src": "https://raw.githubusercontent.com/TA2k/ioBroker.tedee/main/admin/tedee_api.png",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "bridgeip": {
          "type": "text",
          "label": "Bridge IP",
          "placeholder": "192.168.x.x",
          "help": "Shown in the Tedee app under bridge → Settings → API",
          "validator": "!!data.bridgeip && data.bridgeip.trim().length > 0",
          "validatorErrorText": "Please enter the IP address of the bridge",
          "validatorNoSaveOnError": true,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "token": {
          "type": "password",
          "label": "Bridge Token",
          "help": "API token from the Tedee app (Bridge -> Settings -> API)",
          "repeat": false,
          "visible": true,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "_hdrWebhook": {
          "type": "header",
          "text": "Advanced (only needed in special cases)",
          "size": 3,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "callbackHost": {
          "type": "text",
          "label": "Callback host",
          "placeholder": "auto",
          "help": "Leave empty. Only needed if the lock status does not update, e.g. with Docker: enter the IP address of the ioBroker computer that the bridge can reach.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "interval": {
          "type": "number",
          "label": "Update interval",
          "help": "Changes arrive immediately. The lock is additionally read at this interval as a backup.",
          "min": 1,
          "max": 86400,
          "unit": "s",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        }
      }
    },
    "tab_pins": {
      "type": "panel",
      "label": "PINs",
      "items": {
        "_hdrPins": {
          "type": "header",
          "text": "Keypad PINs",
          "size": 3,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_pinInfo": {
          "type": "staticText",
          "text": "Only needed with a Tedee Keypad.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "loadPinAliases": {
          "type": "checkbox",
          "label": "Load PIN names for lastAction",
          "help": "Shows the name of the PIN in lastAction when the door is opened with the keypad",
          "disabled": "data.pinManagement === true",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "pinManagement": {
          "type": "checkbox",
          "label": "Enable PIN management",
          "help": "Shows all PINs in ioBroker and lets you create, change and delete them. The codes are never saved in ioBroker.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_pinDocLink": {
          "type": "staticLink",
          "label": "Instructions for the PIN management",
          "href": "https://github.com/TA2k/ioBroker.tedee#pin-management-optional",
          "button": true,
          "icon": "info",
          "hidden": "data.pinManagement !== true",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        }
      }
    }
  }
}
