{
  "i18n": true,
  "type": "tabs",
  "items": {
    "tab_connection": {
      "type": "panel",
      "label": "Connection",
      "items": {
        "_hdrBridge": {
          "type": "header",
          "text": "Tedee Bridge",
          "size": 3,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_description": {
          "type": "staticText",
          "text": "Open the Tedee app and enable Beta Testing in the user profile. Then select the bridge, go to Settings -> API and switch the API on. Enter the IP address and the token of the bridge below.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_docLink": {
          "type": "staticLink",
          "label": "Bridge API documentation",
          "href": "https://docs.tedee.com/bridge-api#tag/Getting-started",
          "button": true,
          "icon": "info",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "_image": {
          "type": "staticImage",
          "src": "https://raw.githubusercontent.com/TA2k/ioBroker.tedee/main/admin/tedee_api.png",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 6,
          "xl": 6
        },
        "bridgeip": {
          "type": "text",
          "label": "Bridge IP",
          "placeholder": "192.168.x.x",
          "help": "IP address or host name of the Tedee Bridge",
          "validator": "!!data.bridgeip && data.bridgeip.trim().length > 0",
          "validatorErrorText": "Please enter the IP address of the bridge",
          "validatorNoSaveOnError": true,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "token": {
          "type": "password",
          "label": "Bridge Token",
          "help": "API token from the Tedee app (Bridge -> Settings -> API)",
          "repeat": false,
          "visible": true,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "_hdrWebhook": {
          "type": "header",
          "text": "Webhooks and polling",
          "size": 3,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "callbackHost": {
          "type": "text",
          "label": "Callback host",
          "placeholder": "auto",
          "help": "IP of this ioBroker system that the bridge can reach (port 29170). Empty = first IPv4 address. Needed for Docker, several network interfaces or IPv6.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        },
        "interval": {
          "type": "number",
          "label": "Update interval",
          "help": "Status updates arrive immediately via webhooks, polling is only a backup",
          "min": 1,
          "max": 86400,
          "unit": "s",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        }
      }
    },
    "tab_pins": {
      "type": "panel",
      "label": "PINs",
      "items": {
        "_hdrPins": {
          "type": "header",
          "text": "Keypad PINs",
          "size": 3,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_pinInfo": {
          "type": "staticText",
          "text": "Requires a Tedee Keypad and Bridge API 1.19 or newer. While the bridge reads the PIN list from the lock it cannot handle other requests (about 1 second per 5 PINs).",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "loadPinAliases": {
          "type": "checkbox",
          "label": "Load PIN names for lastAction",
          "help": "Shows the name of the PIN in lastAction.pinAlias when the lock is opened with the keypad",
          "disabled": "data.pinManagement === true",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "pinManagement": {
          "type": "checkbox",
          "label": "Enable PIN management",
          "help": "Shows all PINs of the lock as states and allows to create, change and delete PINs (sendTo commands and delete button). PIN codes are never stored in states.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_pinDocLink": {
          "type": "staticLink",
          "label": "Instructions for the PIN management",
          "href": "https://github.com/TA2k/ioBroker.tedee#pin-management",
          "button": true,
          "icon": "info",
          "hidden": "data.pinManagement !== true",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4
        }
      }
    }
  }
}
